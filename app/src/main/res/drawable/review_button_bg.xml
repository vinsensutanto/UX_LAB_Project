<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESSED / CLICKED -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#644200"/> <!-- Background -->
            <stroke android:width="2dp" android:color="#F5C34A"/> <!-- Border -->
        </shape>
    </item>

    <!-- HOVERED / FOCUSED (optional enhancement for hover effect) -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#C02147"/> <!-- Hover background -->
            <stroke android:width="2dp" android:color="#C02147"/>
        </shape>
    </item>

    <!-- DEFAULT STATE -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/> <!-- Default background -->
            <stroke android:width="2dp" android:color="#C02147"/> <!-- Default border -->
        </shape>
    </item>
</selector>
